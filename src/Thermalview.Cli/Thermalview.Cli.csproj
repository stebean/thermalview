<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Thermalview.Server\Thermalview.Server.csproj" />
    <ProjectReference Include="..\Thermalview.Parser\Thermalview.Parser.csproj" />
    <ProjectReference Include="..\Thermalview.Core\Thermalview.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>thermalview</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Self-contained publish settings — only active when running dotnet publish -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Embed the CUPS backend script so it can be extracted at install time -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\cups-backend.sh" LogicalName="cups-backend.sh" />
  </ItemGroup>

</Project>
