<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Thermalview.Parser\Thermalview.Parser.csproj" />
    <ProjectReference Include="..\Thermalview.Core\Thermalview.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Embed frontend files into the assembly so no external files are needed -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.2" />
  </ItemGroup>

  <!-- Embed frontend files as resources with virtual paths matching the web root -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\frontend\**" LogicalName="frontend\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
